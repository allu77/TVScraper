    "typecheck": "tsc --noEmit",
    "ddu-probe": "node tools/ddu-probe/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
