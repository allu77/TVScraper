{
  "name": "tvscraper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm test:tools && pnpm test:legacy",
    "test:tools": "vitest run --root tools",
